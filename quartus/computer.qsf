# GENERAL
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 25.3.1
set_global_assignment -name PROJECT_CREATION_TIME_DATE "14:08:03  APRIL 11, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "25.3.1 Pro Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name TOP_LEVEL_ENTITY system_top
set_global_assignment -name VHDL_FILE ../rtl/reset/reset_synchronizer.vhd
set_global_assignment -name VHDL_FILE ../rtl/top/system_top.vhd
set_global_assignment -name VHDL_FILE ../rtl/cpu/cpu.vhd
set_global_assignment -name VHDL_FILE ../rtl/ram/on_chip_ram.vhd
set_global_assignment -name VHDL_FILE ../rtl/uart/load_from_uart_to_ram.vhd
set_global_assignment -name VHDL_FILE ../rtl/uart/send_from_ram_to_uart.vhd
set_global_assignment -name VHDL_FILE ../rtl/hdmi/i2c.vhd
set_global_assignment -name VHDL_FILE ../rtl/hdmi/test.vhd
set_global_assignment -name VHDL_FILE ../rtl/terminal/text_ram.vhd
set_global_assignment -name VHDL_FILE ../rtl/terminal/font_rom.vhd
set_global_assignment -name VHDL_FILE ../rtl/terminal/terminal.vhd
set_global_assignment -name VHDL_FILE ../rtl/terminal/keyboard.vhd
set_global_assignment -name VHDL_FILE ../rtl/sdcard/sdcard.vhd
set_global_assignment -name SDC_FILE computer.sdc

# Pixel-clock synchronizer chains
set_instance_assignment -name SYNCHRONIZER_IDENTIFICATION FORCED -to "terminal|enable_meta"
set_instance_assignment -name DONT_MERGE_REGISTER ON -to "terminal|enable_meta"
set_instance_assignment -name PRESERVE_REGISTER ON -to "terminal|enable_meta"
set_instance_assignment -name DONT_MERGE_REGISTER ON -to "terminal|enable_pixel"
set_instance_assignment -name PRESERVE_REGISTER ON -to "terminal|enable_pixel"

set_instance_assignment -name SYNCHRONIZER_IDENTIFICATION FORCED -to "terminal|clear_meta"
set_instance_assignment -name DONT_MERGE_REGISTER ON -to "terminal|clear_meta"
set_instance_assignment -name PRESERVE_REGISTER ON -to "terminal|clear_meta"
set_instance_assignment -name DONT_MERGE_REGISTER ON -to "terminal|clear_pixel"
set_instance_assignment -name PRESERVE_REGISTER ON -to "terminal|clear_pixel"

set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name DEVICE A3CZ135BB18AE7S
set_global_assignment -name FAMILY "Agilex 3"
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256

# CLOCK
set_instance_assignment -name IO_STANDARD "1.2-V" -to CLOCK0_50
